{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/followup",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/jarvis?periodo=manha",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron/jarvis?periodo=fechamento",
      "schedule": "30 21 * * 1-5"
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "sonare.com.br" }],
      "destination": "https://www.sonareengenharia.com.br/",
      "permanent": false
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.sonare.com.br" }],
      "destination": "https://www.sonareengenharia.com.br/",
      "permanent": false
    }
  ]
}
