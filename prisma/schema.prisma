// SONARE CRM — Schema do banco de dados
// Convenções:
//  - PKs: UUID v7
//  - Dinheiro: Decimal(14,2) — NUNCA float
//  - Percentuais/quantidades: Decimal(9,4)
//  - Exclusão lógica: deletedAt
//  - Auditoria: createdAt/updatedAt/createdById/updatedById (ids sem FK para reduzir acoplamento)
//  - companyId em todas as entidades de negócio (preparação multiempresa)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// NÚCLEO / SEGURANÇA
// ============================================================

model Company {
  id                 String    @id @default(uuid(7))
  legalName          String
  tradeName          String?
  cnpj               String?   @unique
  stateRegistration  String?
  cityRegistration   String?
  email              String?
  phone              String?
  whatsapp           String?
  website            String?
  addressStreet      String?
  addressNumber      String?
  addressComplement  String?
  addressDistrict    String?
  zipCode            String?
  city               String?
  state              String?
  country            String?   @default("Brasil")
  logoAttachmentId   String?
  bankInfo           Json?     // dados bancários e chave Pix
  crea               String?
  /// Razão social usada nas minutas de contrato, quando difere da fiscal
  contractLegalName  String?
  /// Sócios/representantes que assinam contratos:
  /// [{ name, nationality, maritalStatus, profession, rg, cpf, role }]
  legalRepresentatives Json?
  timezone           String    @default("America/Cuiaba")
  currency           String    @default("BRL")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model User {
  id                  String    @id @default(uuid(7))
  companyId           String
  name                String
  email               String    @unique
  passwordHash        String
  active              Boolean   @default(true)
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  hourlyCost          Decimal?  @db.Decimal(14, 2) // custo/hora p/ rentabilidade
  hourlyRate          Decimal?  @db.Decimal(14, 2) // valor/hora faturável
  creaCau             String?   // registro profissional, quando aplicável
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  roles                    UserRole[]
  extraPermissions         UserPermission[]
  auditLogs                AuditLog[]
  clientsOwned             Client[]                  @relation("ClientCommercialOwner")
  opportunitiesCommercial  Opportunity[]             @relation("OppCommercialOwner")
  opportunitiesTechnical   Opportunity[]             @relation("OppTechnicalOwner")
  activities               OpportunityActivity[]
  budgetsCommercial        Budget[]                  @relation("BudgetCommercialOwner")
  budgetsTechnical         Budget[]                  @relation("BudgetTechnicalOwner")
  approvalsRequested       BudgetApproval[]          @relation("ApprovalRequestedBy")
  approvalsDecided         BudgetApproval[]          @relation("ApprovalDecidedBy")
  projectsLed              Project[]                 @relation("ProjectTechnicalLead")
  projectsCoordinated      Project[]                 @relation("ProjectCoordinator")
  projectMemberships       ProjectMember[]
  tasksAssigned            Task[]                    @relation("TaskAssignee")
  timeEntries              TimeEntry[]
  technicalResponsibilities TechnicalResponsibility[]
  comments                 Comment[]
  notifications            Notification[]
  equipmentHeld            EquipmentMovement[]       @relation("EquipmentHolder")

  @@index([companyId])
}

model Role {
  id          String   @id @default(uuid(7))
  companyId   String
  code        String   // ADMIN, COMERCIAL, ENGENHARIA, FINANCEIRO, DIRETORIA, EXTERNO, CLIENTE
  name        String
  description String?
  isSystem    Boolean  @default(false) // papéis do sistema não podem ser excluídos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
}

model Permission {
  id          String  @id @default(uuid(7))
  code        String  @unique // formato recurso:ação — ex.: client:read, budget:approve
  description String?

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Session {
  id         String   @id @default(uuid(7))
  userId     String
  tokenHash  String   @unique // SHA-256 do token; o token em si só existe no cookie
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid(7))
  companyId  String
  userId     String?
  action     String   // create | update | delete | login | approve | ...
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid(7))
  companyId String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  updatedById String?

  @@unique([companyId, key])
}

model DocumentSequence {
  id        String @id @default(uuid(7))
  companyId String
  type      String // OPP, ORC, PROP, CTR, PRJ, PARC...
  year      Int
  nextValue Int    @default(1)

  @@unique([companyId, type, year])
}

enum CustomFieldType {
  TEXT
  NUMBER
  CURRENCY
  DATE
  SELECT
  MULTI_SELECT
  BOOLEAN
  EMAIL
  PHONE
  URL
  LONG_TEXT
}

model CustomField {
  id         String          @id @default(uuid(7))
  companyId  String
  entityType String          // client | opportunity | budget | contract | project | task | invoice
  name       String
  fieldType  CustomFieldType
  options    Json?           // para SELECT/MULTI_SELECT
  required   Boolean         @default(false)
  active     Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  values CustomFieldValue[]

  @@index([companyId, entityType])
}

model CustomFieldValue {
  id            String      @id @default(uuid(7))
  customFieldId String
  entityId      String
  value         Json
  updatedAt     DateTime    @updatedAt
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
}

// ============================================================
// CLIENTES
// ============================================================

enum PersonType {
  FISICA
  JURIDICA
}

enum ClientStatus {
  ATIVO
  INATIVO
  BLOQUEADO
}

model Client {
  id                 String       @id @default(uuid(7))
  companyId          String
  code               String?      // código interno opcional
  personType         PersonType
  legalName          String       // razão social ou nome completo
  tradeName          String?
  cpf                String?
  cnpj               String?
  stateRegistration  String?
  cityRegistration   String?
  email              String?
  phone              String?
  whatsapp           String?
  website            String?
  addressStreet      String?
  addressNumber      String?
  addressComplement  String?
  addressDistrict    String?
  zipCode            String?
  city               String?
  state              String?
  country            String?      @default("Brasil")
  notes              String?
  status             ClientStatus @default(ATIVO)
  leadSourceId       String?
  segment            String?
  firstContactAt     DateTime?
  commercialOwnerId  String?
  tags               String[]     @default([])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  leadSource      LeadSource?   @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  commercialOwner User?         @relation("ClientCommercialOwner", fields: [commercialOwnerId], references: [id], onDelete: SetNull)
  contacts        ClientContact[]
  units           ClientUnit[]
  opportunities   Opportunity[]
  budgets         Budget[]
  contracts       Contract[]
  projects        Project[]
  receivables     Receivable[]
  invoices        Invoice[]
  equipmentMovements EquipmentMovement[]
  activities      OpportunityActivity[]

  @@index([companyId, status])
  @@index([companyId, cnpj])
  @@index([companyId, cpf])
}

model ClientContact {
  id            String   @id @default(uuid(7))
  clientId      String
  name          String
  position      String?
  email         String?
  phone         String?
  whatsapp      String?
  department    String?
  decisionMaker Boolean  @default(false)
  isPrimary     Boolean  @default(false)
  isFinancial   Boolean  @default(false)
  isTechnical   Boolean  @default(false)
  isContractual Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  budgets       Budget[]

  @@index([clientId])
}

model ClientUnit {
  id          String   @id @default(uuid(7))
  clientId    String
  name        String
  unitType    String?  // obra, fazenda, usina, filial, condomínio, UC, centro de custo...
  consumerUnit String? // nº da unidade consumidora, quando aplicável
  addressStreet String?
  addressNumber String?
  addressDistrict String?
  zipCode     String?
  city        String?
  state       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  budgets       Budget[]
  contracts     Contract[]
  projects      Project[]

  @@index([clientId])
}

model LeadSource {
  id        String   @id @default(uuid(7))
  companyId String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  clients       Client[]
  opportunities Opportunity[]

  @@unique([companyId, name])
}

// ============================================================
// CRM / PIPELINE
// ============================================================

enum StageKind {
  ABERTA
  GANHA
  PERDIDA
  SUSPENSA
}

model OpportunityStage {
  id        String    @id @default(uuid(7))
  companyId String
  name      String
  kind      StageKind @default(ABERTA)
  color     String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  /// Comemora na tela quando um cartão chega aqui. É escolha de cada
  /// empresa: a vitória é o "sim" do cliente, e o que vem depois costuma
  /// ser trâmite — mas onde exatamente isso acontece muda de quadro
  /// para quadro.
  celebrate Boolean   @default(false)
  /// Cria o projeto automaticamente quando o cartão chega aqui. É a etapa
  /// em que o trabalho começa de fato — varia entre empresas.
  createsProject Boolean @default(false)

  opportunities Opportunity[]

  @@unique([companyId, name])
}

enum PriorityLevel {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model Opportunity {
  id                  String        @id @default(uuid(7))
  companyId           String
  code                String        // OPP-AAAA-NNN
  title               String
  clientId            String
  clientUnitId        String?
  primaryContactId    String?
  description         String?
  serviceCatalogId    String?
  discipline          String?
  commercialOwnerId   String?
  technicalOwnerId    String?
  leadSourceId        String?
  estimatedValue      Decimal?      @db.Decimal(14, 2)
  probability         Decimal?      @db.Decimal(9, 4) // 0–100
  expectedCloseDate   DateTime?
  estimatedDuration   String?
  priority            PriorityLevel @default(MEDIA)
  competitors         String?
  hiringReason        String?
  clientNeed          String?
  nextAction          String?
  nextActionDate      DateTime?
  tags                String[]      @default([])
  notes               String?
  checklist           Json?         // checklist de informações necessárias
  stageId             String
  boardPosition       Int           @default(0)
  lossReasonId        String?
  lossNotes           String?
  closedAt            DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  client          Client            @relation(fields: [clientId], references: [id])
  clientUnit      ClientUnit?       @relation(fields: [clientUnitId], references: [id], onDelete: SetNull)
  primaryContact  ClientContact?    @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  serviceCatalog  ServiceCatalog?   @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  commercialOwner User?             @relation("OppCommercialOwner", fields: [commercialOwnerId], references: [id], onDelete: SetNull)
  technicalOwner  User?             @relation("OppTechnicalOwner", fields: [technicalOwnerId], references: [id], onDelete: SetNull)
  leadSource      LeadSource?       @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  stage           OpportunityStage  @relation(fields: [stageId], references: [id])
  lossReason      LossReason?       @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  activities      OpportunityActivity[]
  budgets         Budget[]

  @@unique([companyId, code])
  @@index([companyId, stageId])
  @@index([clientId])
}

enum ActivityType {
  LIGACAO
  REUNIAO
  VISITA_TECNICA
  MENSAGEM
  EMAIL
  TAREFA
  LEMBRETE
  ENVIO_DOCUMENTO
  FOLLOW_UP
  NEGOCIACAO
  DECISAO
}

enum ActivityStatus {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

model OpportunityActivity {
  id            String         @id @default(uuid(7))
  companyId     String
  opportunityId String?
  clientId      String?
  activityType  ActivityType
  title         String
  notes         String?
  responsibleId String?
  dueAt         DateTime?
  completedAt   DateTime?
  status        ActivityStatus @default(PENDENTE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String?
  deletedAt     DateTime?

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsible User?        @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([companyId, status, dueAt])
  @@index([opportunityId])
}

model LossReason {
  id        String  @id @default(uuid(7))
  companyId String
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  opportunities Opportunity[]

  @@unique([companyId, name])
}

model ServiceCatalog {
  id               String   @id @default(uuid(7))
  companyId        String
  code             String
  name             String
  category         String?
  description      String?
  discipline       String?
  unit             String?  // un, m², h, vb...
  defaultPrice     Decimal? @db.Decimal(14, 2)
  estimatedCost    Decimal? @db.Decimal(14, 2)
  estimatedHours   Decimal? @db.Decimal(9, 4)
  scopeTemplate    String?
  premisesTemplate String?
  exclusionsTemplate String?
  deliverables     Json?    // entregáveis associados
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  opportunities Opportunity[]
  budgetItems   BudgetItem[]

  @@unique([companyId, code])
}

// ============================================================
// ORÇAMENTOS E PROPOSTAS
// ============================================================

enum BudgetStatus {
  RASCUNHO
  EM_REVISAO
  APROVACAO_INTERNA
  APROVADO
  RECUSADO
  EXPIRADO
  CANCELADO
}

model Budget {
  id                String       @id @default(uuid(7))
  companyId         String
  code              String       // ORC-AAAA-NNN
  opportunityId     String?
  clientId          String
  clientUnitId      String?
  /// Quem pediu este orçamento. A mesma empresa costuma ter vários
  /// solicitantes, e a proposta precisa sair endereçada ao certo.
  contactId         String?
  commercialOwnerId String?
  technicalOwnerId  String?
  status            BudgetStatus @default(RASCUNHO)
  currentVersionId  String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?

  opportunity     Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  client          Client          @relation(fields: [clientId], references: [id])
  clientUnit      ClientUnit?     @relation(fields: [clientUnitId], references: [id], onDelete: SetNull)
  contact         ClientContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  commercialOwner User?           @relation("BudgetCommercialOwner", fields: [commercialOwnerId], references: [id], onDelete: SetNull)
  technicalOwner  User?           @relation("BudgetTechnicalOwner", fields: [technicalOwnerId], references: [id], onDelete: SetNull)
  currentVersion  BudgetVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions        BudgetVersion[] @relation("BudgetVersions")
  approvals       BudgetApproval[]
  contracts       Contract[]
  projects        Project[]

  @@unique([companyId, code])
  @@index([clientId])
}

model BudgetVersion {
  id                 String    @id @default(uuid(7))
  budgetId           String
  versionNumber      Int       // 1, 2, 3... exibido como V01, V02
  validUntil         DateTime?
  serviceType        String?
  scope              String?
  premises           String?
  exclusions         String?
  referenceDocuments String?
  executionDeadline  String?
  deliveryMethod     String?
  paymentTerms       String?   // descrição textual da forma de pagamento
  paymentSchedule    Json?     // estrutura de parcelas p/ gerar cronograma
  subtotal           Decimal   @default(0) @db.Decimal(14, 2)
  discount           Decimal   @default(0) @db.Decimal(14, 2)
  surcharge          Decimal   @default(0) @db.Decimal(14, 2)
  taxes              Decimal   @default(0) @db.Decimal(14, 2)
  estimatedRetentions Decimal  @default(0) @db.Decimal(14, 2)
  totalCost          Decimal   @default(0) @db.Decimal(14, 2)
  grossMargin        Decimal   @default(0) @db.Decimal(14, 2)
  marginPercent      Decimal   @default(0) @db.Decimal(9, 4)
  total              Decimal   @default(0) @db.Decimal(14, 2)
  internalNotes      String?
  clientNotes        String?
  /// Sobrescreve o texto padrão da empresa (Configurações > Comercial) só
  /// para esta proposta. null = usa o padrão; string (mesmo vazia) = usa
  /// este texto, porque nem todo serviço se encaixa no texto genérico.
  generalInfoOverride String?
  differentialsOverride String?
  changeReason       String?   // justificativa da versão
  immutable          Boolean   @default(false) // true após envio/aprovação
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?

  budget          Budget       @relation("BudgetVersions", fields: [budgetId], references: [id], onDelete: Cascade)
  currentOfBudget Budget?      @relation("CurrentVersion")
  items           BudgetItem[]
  proposals       Proposal[]

  @@unique([budgetId, versionNumber])
}

model BudgetItem {
  id               String   @id @default(uuid(7))
  budgetVersionId  String
  serviceCatalogId String?
  description      String
  discipline       String?
  stage            String?
  itemType         String?  // serviço, hora técnica, despesa, deslocamento, ART/RRT, terceirização...
  unit             String?
  quantity         Decimal  @default(1) @db.Decimal(9, 4)
  unitPrice        Decimal  @default(0) @db.Decimal(14, 2)
  unitCost         Decimal  @default(0) @db.Decimal(14, 2)
  discount         Decimal  @default(0) @db.Decimal(14, 2)
  total            Decimal  @default(0) @db.Decimal(14, 2)
  sortOrder        Int      @default(0)

  budgetVersion  BudgetVersion   @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)

  @@index([budgetVersionId])
}

enum ApprovalStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

model BudgetApproval {
  id            String         @id @default(uuid(7))
  budgetId      String
  ruleTriggered String         // ex.: desconto_acima_maximo, margem_abaixo_minima, valor_acima_limite
  requestedById String?
  decidedById   String?
  status        ApprovalStatus @default(PENDENTE)
  comment       String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  budget      Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?  @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
}

enum ProposalType {
  COMERCIAL
  TECNICA
  UNIFICADA
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  VISUALIZADA
  ACEITA
  RECUSADA
  EXPIRADA
}

model Proposal {
  id               String         @id @default(uuid(7))
  companyId        String
  code             String         // PROP-AAAA-NNN
  budgetVersionId  String
  templateId       String?
  proposalType     ProposalType   @default(UNIFICADA)
  status           ProposalStatus @default(RASCUNHO)
  pdfAttachmentId  String?
  /// Quantas vezes o PDF foi emitido. O número da proposta não muda ao
  /// reemitir os mesmos dados — só uma nova versão do orçamento gera outro.
  emissionCount    Int            @default(1)
  /// Renegociação: o número da proposta é o mesmo, mas o documento vira
  /// "PROP-AAAA-NNN Rev. 01". 0 = oferta original, sem revisão.
  revision         Int            @default(0)
  lastEmittedAt    DateTime?
  // Assinatura eletrônica (MP 2.200-2 art. 10 §2º): código público de conferência
  // + hash do PDF emitido. Para ICP-Brasil (PAdES) ver docs/ARQUITETURA.md.
  verificationCode   String?      @unique
  signedElectronicallyAt DateTime?
  signerName         String?
  signerRegistration String?
  documentHash       String?      // SHA-256 do PDF emitido
  sentAt           DateTime?
  sentVia          String?
  recipients       String?
  viewedAt         DateTime?
  /// Toda abertura do link público conta, não só a primeira: depois de uma
  /// renegociação o que importa é se o cliente voltou a olhar a proposta.
  lastViewedAt     DateTime?
  viewCount        Int            @default(0)
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  negotiationNotes String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdById      String?
  deletedAt        DateTime?

  budgetVersion BudgetVersion     @relation(fields: [budgetVersionId], references: [id])
  template      ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  contracts     Contract[]
  followUps     FollowUpEvent[]

  @@unique([companyId, code])
}

model ProposalTemplate {
  id           String       @id @default(uuid(7))
  companyId    String
  name         String
  proposalType ProposalType @default(UNIFICADA)
  html         String       // template com variáveis {{...}}
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  proposals Proposal[]

  @@unique([companyId, name])
}

// ============================================================
// CONTRATOS
// ============================================================

enum ContractStatus {
  MINUTA
  EM_REVISAO_INTERNA
  AGUARDANDO_APROVACAO
  ENVIADO_AO_CLIENTE
  EM_NEGOCIACAO
  AGUARDANDO_ASSINATURA
  ASSINADO
  VIGENTE
  SUSPENSO
  ENCERRADO
  RESCINDIDO
  CANCELADO
}

model Contract {
  id               String         @id @default(uuid(7))
  companyId        String
  code             String         // CTR-AAAA-NNN
  contractNumber   String?        // numeração externa, se houver
  clientId         String
  clientUnitId     String?
  proposalId       String?
  budgetId         String?
  subject          String         // objeto
  scope            String?
  totalValue       Decimal        @db.Decimal(14, 2)
  startDate        DateTime?
  endDate          DateTime?
  durationDays     Int?
  paymentTerms     String?
  paymentSchedule  Json?          // estrutura das parcelas (herdada do orçamento, editável)
  adjustmentIndex  String?        // índice de reajuste
  baseDate         DateTime?
  penalties        String?
  guarantees       String?
  retentions       String?
  obligations      String?
  terminationTerms String?
  jurisdiction     String?        // foro
  witnesses        Json?          // [{ name, cpf }] — testemunhas do instrumento
  /// Variáveis específicas da minuta (prazo, formatos de entrega, revisões inclusas…)
  templateVariables Json?
  status           ContractStatus @default(MINUTA)
  templateId       String?
  signedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?

  client     Client              @relation(fields: [clientId], references: [id])
  clientUnit ClientUnit?         @relation(fields: [clientUnitId], references: [id], onDelete: SetNull)
  proposal   Proposal?           @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  budget     Budget?             @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  template   ContractTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions   ContractVersion[]
  amendments ContractAmendment[]
  signatures ContractSignature[]
  projects   Project[]
  receivables Receivable[]
  invoices   Invoice[]

  @@unique([companyId, code])
  @@index([clientId, status])
}

model ContractVersion {
  id              String   @id @default(uuid(7))
  contractId      String
  versionNumber   Int
  pdfAttachmentId String?
  variables       Json?    // variáveis resolvidas no momento da geração
  notes           String?
  // Assinatura eletrônica da minuta (mesmo esquema da proposta)
  verificationCode String? @unique
  documentHash     String?
  createdAt       DateTime @default(now())
  createdById      String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, versionNumber])
}

enum AmendmentType {
  VALOR
  PRAZO
  ESCOPO
  FORMA_PAGAMENTO
  RESPONSABILIDADE
  SUSPENSAO
  RETOMADA
  RESCISAO
}

model ContractAmendment {
  id              String        @id @default(uuid(7))
  contractId      String
  number          Int
  amendmentType   AmendmentType
  description     String
  valueDelta      Decimal?      @db.Decimal(14, 2)
  newEndDate      DateTime?
  pdfAttachmentId String?
  status          ContractStatus @default(MINUTA)
  signedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  deletedAt       DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, number])
}

model ContractSignature {
  id               String    @id @default(uuid(7))
  contractId       String
  signerName       String
  signerRole       String?   // contratante, contratada, testemunha
  signerEmail      String?
  signedAt         DateTime?
  signedFileId     String?   // Attachment com o contrato assinado
  status           String    @default("pendente")
  createdAt        DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ContractTemplate {
  id          String   @id @default(uuid(7))
  companyId   String
  name        String
  /// PROJETO | LAUDO | EMPREITADA | OUTRO — define o texto base
  kind        String   @default("OUTRO")
  serviceType String?
  /// Cláusulas em JSON: [{ title, paragraphs: [...] }] com variáveis {{...}}.
  /// A numeração (Cláusula Primeira, 1.1, 1.2…) é gerada automaticamente.
  clauses     Json
  /// Texto de abertura ("As partes contraentes têm entre si…")
  preamble    String?
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts Contract[]

  @@unique([companyId, name])
}

// ============================================================
// PROJETOS
// ============================================================

enum ProjectStatus {
  AGUARDANDO_INICIO
  EM_MOBILIZACAO
  AGUARDANDO_DOCUMENTOS
  EM_LEVANTAMENTO
  EM_DESENVOLVIMENTO
  EM_REVISAO_INTERNA
  ENVIADO_AO_CLIENTE
  AGUARDANDO_APROVACAO
  EM_REVISAO_DO_CLIENTE
  EM_APROVACAO_EXTERNA
  AGUARDANDO_CONCESSIONARIA
  AGUARDANDO_ORGAO_PUBLICO
  SUSPENSO
  CONCLUIDO
  ENCERRADO
  CANCELADO
}

model Project {
  id                  String        @id @default(uuid(7))
  companyId           String
  code                String        // PRJ-AAAA-NNN
  name                String
  clientId            String
  clientUnitId        String?
  contractId          String?
  budgetId            String?
  technicalLeadId     String?
  coordinatorId       String?
  disciplines         String[]      @default([])
  startDate           DateTime?
  contractualDeadline DateTime?
  expectedEndDate     DateTime?
  actualEndDate       DateTime?
  contractValue       Decimal?      @db.Decimal(14, 2)
  status              ProjectStatus @default(AGUARDANDO_INICIO)
  priority            PriorityLevel @default(MEDIA)
  progressPercent     Decimal       @default(0) @db.Decimal(9, 4)
  boardPosition       Int           @default(0)
  archivedAt          DateTime?
  /// Pasta de rede com os documentos do projeto (ex.: Z:\SONARE\Projetos\...)
  folderPath          String?
  /// O projeto é uma obra com diário (RDO)? Nem todo projeto exige — laudo
  /// e consultoria não têm canteiro. A marcação é o que faz o projeto
  /// aparecer no módulo de Obras e cobrar diário nos dias úteis.
  diaryEnabled        Boolean   @default(false)
  /// Geofence da obra: centro e raio para classificar os registros de campo.
  /// Nunca bloqueia — só rastreia (o GPS erra e o estacionamento fica fora).
  siteAddress         String?
  siteLat             Float?
  siteLng             Float?
  siteRadiusM         Int?
  /// O projeto exige ART/RRT? O número fica no módulo de ART; aqui mora só a
  /// decisão, que é do gestor. "Não informado" é estado de alerta: projeto
  /// entregue sem ART e sem alguém ter dito que não precisava é risco.
  artStatus           ArtStatus @default(NAO_INFORMADO)
  /// Por que foi dispensada — protege a decisão de quem assinou por ela.
  artNotes            String?
  risks               String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  client        Client          @relation(fields: [clientId], references: [id])
  clientUnit    ClientUnit?     @relation(fields: [clientUnitId], references: [id], onDelete: SetNull)
  contract      Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  budget        Budget?         @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  technicalLead User?           @relation("ProjectTechnicalLead", fields: [technicalLeadId], references: [id], onDelete: SetNull)
  coordinator   User?           @relation("ProjectCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  stages        ProjectStage[]
  members       ProjectMember[]
  tasks         Task[]
  deliverables  Deliverable[]
  timeEntries   TimeEntry[]
  technicalResponsibilities TechnicalResponsibility[]
  pendencies    ClientPendency[]
  receivables   Receivable[]
  invoices      Invoice[]
  payables      Payable[]
  equipmentMovements EquipmentMovement[]
  externalApprovals  ExternalApproval[]
  diaries            ConstructionDiary[]

  @@unique([companyId, code])
  @@index([clientId, status])
}

// ============================================================
// DIÁRIO DE OBRAS (RDO)
// ============================================================

enum DiaryStatus {
  ABERTO
  FINALIZADO
  APROVADO
}

/// Tipos de registro do dia. O específico de cada tipo vai em `payload`:
/// os campos comuns (título, descrição, horário, responsável) cobrem 90%
/// dos casos, e oito tabelas quase iguais custariam mais que informam.
enum DiaryEntryKind {
  ATIVIDADE
  OCORRENCIA
  IMPEDIMENTO
  ORIENTACAO
  VISITANTE
  MATERIAL
  OBSERVACAO
}

/// Um dia de obra. Um por projeto por dia — o dia é o do fuso da obra.
model ConstructionDiary {
  id          String      @id @default(uuid(7))
  companyId   String
  projectId   String
  /// Sequencial dentro do projeto (1, 2, 3…).
  number      Int
  /// RDO-2026-004-001 — ano, projeto, sequencial.
  code        String
  /// Dia de trabalho (YYYY-MM-DD no fuso da obra), gravado como texto para
  /// não sofrer deslocamento de fuso na ida e volta do banco.
  diaryDate   String
  status      DiaryStatus @default(ABERTO)

  openedAt     DateTime  @default(now())
  openedById   String?
  closedAt     DateTime?
  closedById   String?

  /// Localização do aparelho na abertura, quando autorizada.
  openLat      Float?
  openLng      Float?
  openAccuracy Float?
  /// DENTRO | PROXIMO | FORA | INDISPONIVEL — comparação com a geofence.
  geofence     String?
  geofenceDistM Int?

  /// Clima consultado na abertura: { fonte, consultadoEm, rotulo, tempC, … }.
  weather      Json?
  /// Clima impediu serviços? Preenchido à mão quando sim.
  weatherBlocked Boolean @default(false)
  weatherNotes String?

  /// Narrativa do dia, gerada dos registros e revisável antes do fechamento.
  narrative    String?
  notes        String?
  /// Pendências apontadas no fechamento que o usuário decidiu ignorar.
  ignoredWarnings Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries   DiaryEntry[]
  workforce DiaryWorkforce[]
  equipment DiaryEquipment[]

  @@unique([projectId, diaryDate])
  @@unique([companyId, code])
  @@index([companyId, status])
}

model DiaryEntry {
  id          String         @id @default(uuid(7))
  diaryId     String
  kind        DiaryEntryKind
  title       String
  description String?
  /// Quando aconteceu (informado ou o momento do registro).
  happenedAt  DateTime       @default(now())
  /// Campos específicos do tipo: quantidade/unidade da atividade, gravidade
  /// da ocorrência, responsável pelo impedimento…
  payload     Json?
  /// ABERTA | RESOLVIDA — só para ocorrência e impedimento.
  status      String?
  responsible String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  diary ConstructionDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId, kind])
}

/// Equipe presente, por função — o controle nominal é opcional e vem depois.
model DiaryWorkforce {
  id        String  @id @default(uuid(7))
  diaryId   String
  role      String
  company   String?
  quantity  Int     @default(1)
  startTime String?
  endTime   String?
  notes     String?

  diary ConstructionDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
}

model DiaryEquipment {
  id             String   @id @default(uuid(7))
  diaryId        String
  name           String
  identification String?
  quantity       Int      @default(1)
  hours          Decimal? @db.Decimal(9, 4)
  company        String?
  notes          String?

  diary ConstructionDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
}

enum StageStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model ProjectStage {
  id          String      @id @default(uuid(7))
  projectId   String
  name        String
  sortOrder   Int         @default(0)
  status      StageStatus @default(PENDENTE)
  startedAt   DateTime?
  completedAt DateTime?
  dueAt       DateTime?
  notes       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  deliverables Deliverable[]

  @@index([projectId])
}

model ProjectMember {
  projectId String
  userId    String
  roleInProject String? // projetista, revisor, coordenador...

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  EM_REVISAO
  BLOQUEADA
  CONCLUIDA
  CANCELADA
}

model Task {
  id             String        @id @default(uuid(7))
  companyId      String
  projectId      String?
  stageId        String?
  deliverableId  String?
  title          String
  description    String?
  assigneeId     String?
  collaborators  String[]      @default([]) // ids de usuários
  priority       PriorityLevel @default(MEDIA)
  startDate      DateTime?
  dueAt          DateTime?
  completedAt    DateTime?
  status         TaskStatus    @default(A_FAZER)
  estimatedHours Decimal?      @db.Decimal(9, 4)
  labels         String[]      @default([])
  dependsOnIds   String[]      @default([])
  boardPosition  Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  project     Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  deliverable Deliverable?  @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checklist   TaskChecklistItem[]
  timeEntries TimeEntry[]

  @@index([companyId, status, dueAt])
  @@index([projectId])
}

model TaskChecklistItem {
  id        String   @id @default(uuid(7))
  taskId    String
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum DeliverableStatus {
  PENDENTE
  EM_ELABORACAO
  EM_REVISAO
  EMITIDO
  APROVADO
  REPROVADO
  CANCELADO
}

model Deliverable {
  id             String            @id @default(uuid(7))
  projectId      String
  stageId        String?
  code           String?
  name           String
  discipline     String?
  description    String?
  responsibleId  String?           // id de usuário (sem FK p/ simplificar)
  dueAt          DateTime?
  status         DeliverableStatus @default(PENDENTE)
  currentRevision String?          // R00, R01...
  issuedAt       DateTime?
  approvedAt     DateTime?
  dependsOnIds   String[]          @default([])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     ProjectStage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  revisions DeliverableRevision[]
  tasks     Task[]

  @@index([projectId])
}

enum RevisionStatus {
  EM_ELABORACAO
  EMITIDA
  APROVADA
  REPROVADA
  SUBSTITUIDA
}

model DeliverableRevision {
  id            String         @id @default(uuid(7))
  deliverableId String
  revisionCode  String         // R00, R01, ..., AS_BUILT, FINAL
  revisionDate  DateTime       @default(now())
  responsibleId String?
  reason        String?
  changes       String?        // descrição das alterações
  attachmentId  String?        // arquivo desta revisão — imutável após emissão
  status        RevisionStatus @default(EM_ELABORACAO)
  clientComments String?
  createdAt     DateTime       @default(now())
  createdById   String?

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, revisionCode])
}

model TimeEntry {
  id          String    @id @default(uuid(7))
  companyId   String
  userId      String
  projectId   String
  taskId      String?
  workDate    DateTime
  hours       Decimal   @db.Decimal(9, 4)
  description String?
  billable    Boolean   @default(true)
  hourlyCost  Decimal?  @db.Decimal(14, 2)
  hourlyRate  Decimal?  @db.Decimal(14, 2)
  approvedAt  DateTime?
  approvedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, workDate])
  @@index([userId, workDate])
}

enum TechRespStatus {
  PENDENTE
  EMITIDA
  BAIXADA
  CANCELADA
}

/// Decisão do gestor sobre a necessidade de ART/RRT no projeto.
enum ArtStatus {
  NAO_INFORMADO
  NECESSARIA
  DISPENSADA
}

enum ExternalApprovalKind {
  CONCESSIONARIA
}

enum ExternalApprovalStatus {
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum ApprovalStepStatus {
  PENDENTE
  AGUARDANDO_CONCESSIONARIA
  CONCLUIDO
  DISPENSADO
}

/// Processo de aprovação em órgão externo aberto para um projeto.
model ExternalApproval {
  id        String                 @id @default(uuid(7))
  companyId String
  projectId String
  kind      ExternalApprovalKind   @default(CONCESSIONARIA)
  /// Nome do órgão — "Energisa", "Corpo de Bombeiros"…
  orgao     String
  status    ExternalApprovalStatus @default(EM_ANDAMENTO)
  notes     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  createdById String?
  deletedAt DateTime?

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps   ExternalApprovalStep[]

  @@index([companyId, status])
}

/// Um passo do processo, com o protocolo e o prazo que corre por ele.
model ExternalApprovalStep {
  id         String             @id @default(uuid(7))
  approvalId String
  /// Código do modelo do fluxo (SOLICITAR_ORCAMENTO, PROTOCOLAR_PROJETO…).
  code       String
  name       String
  sortOrder  Int                @default(0)
  status     ApprovalStepStatus @default(PENDENTE)
  /// Protocolo devolvido pelo órgão; é dele que o prazo conta.
  protocol   String?
  protocolAt DateTime?
  /// Dias corridos de prazo do órgão. Copiado do modelo na abertura, para
  /// mudança de regulamento não reescrever processo já em curso.
  deadlineDays Int?
  respondedAt DateTime?
  /// Registro da cobrança formal — muda a sugestão para ouvidoria.
  chargedAt  DateTime?
  /// Desfecho do passo de decisão: ACEITO, RECUSADO, COM_EXIGENCIAS…
  outcome    String?
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  approval ExternalApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId, sortOrder])
}

model TechnicalResponsibility {
  id           String         @id @default(uuid(7))
  companyId    String
  projectId    String?
  number       String         // nº da ART/RRT
  docType      String         // ART | RRT | TRT
  council      String?        // CREA-MT, CAU...
  professionalId String?      // usuário interno, quando aplicável
  professionalName String?
  registration String?        // CREA/CAU do profissional
  issuedAt     DateTime?
  value        Decimal?       @db.Decimal(14, 2)
  status       TechRespStatus @default(PENDENTE)
  serviceDescription String?
  attachmentId String?
  dischargedAt DateTime?      // data de baixa
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  professional User?    @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}

enum PendencyStatus {
  ABERTA
  RECEBIDA
  CANCELADA
}

model ClientPendency {
  id             String         @id @default(uuid(7))
  projectId      String
  title          String         // documento ou decisão pendente
  clientContact  String?        // responsável no cliente
  requestedAt    DateTime       @default(now())
  dueAt          DateTime?
  impact         String?
  status         PendencyStatus @default(ABERTA)
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// ============================================================
// DOCUMENTOS / COMENTÁRIOS
// ============================================================

model Attachment {
  id         String    @id @default(uuid(7))
  companyId  String
  entityType String    // client | opportunity | budget | proposal | contract | project | task | deliverable | invoice | receipt | company
  entityId   String
  category   String?   // §8.2
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  storageKey String    // chave no storage (local ou S3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  createdById String?
  deletedAt  DateTime?

  @@index([companyId, entityType, entityId])
}

model Comment {
  id         String    @id @default(uuid(7))
  companyId  String
  entityType String
  entityId   String
  authorId   String?
  body       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, entityType, entityId])
}

// ============================================================
// FINANCEIRO
// ============================================================

enum ReceivableStatus {
  PREVISTO
  A_FATURAR
  AGUARDANDO_AUTORIZACAO
  NF_EMITIDA
  ENVIADO_AO_CLIENTE
  A_VENCER
  VENCIDO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  RENEGOCIADO
  CANCELADO
  EM_COBRANCA
  INADIMPLENTE
}

model Receivable {
  id              String           @id @default(uuid(7))
  companyId       String
  code            String           // PARC-AAAA-NNN
  contractId      String?
  projectId       String?
  clientId        String
  description     String
  installmentNumber Int            @default(1)
  competenceDate  DateTime?
  issueDate       DateTime?
  dueDate         DateTime
  grossValue      Decimal          @db.Decimal(14, 2)
  discount        Decimal          @default(0) @db.Decimal(14, 2)
  surcharge       Decimal          @default(0) @db.Decimal(14, 2)
  retentions      Json?            // detalhe por tributo: [{tipo, percentual, valor}]
  retentionsTotal Decimal          @default(0) @db.Decimal(14, 2)
  netValue        Decimal          @db.Decimal(14, 2)
  status          ReceivableStatus @default(PREVISTO)
  paymentMethodId String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?

  contract      Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client        Client         @relation(fields: [clientId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  receipts      Receipt[]
  invoiceLinks  InvoiceReceivable[]
  collectionEvents CollectionEvent[]

  @@unique([companyId, code])
  @@index([companyId, status, dueDate])
  @@index([clientId])
}

model Receipt {
  id            String    @id @default(uuid(7))
  companyId     String
  receivableId  String
  receivedAt    DateTime
  amount        Decimal   @db.Decimal(14, 2) // valor efetivamente recebido
  interest      Decimal   @default(0) @db.Decimal(14, 2) // juros
  fine          Decimal   @default(0) @db.Decimal(14, 2) // multa
  discount      Decimal   @default(0) @db.Decimal(14, 2)
  bankFee       Decimal   @default(0) @db.Decimal(14, 2)
  retentions    Json?     // retenções efetivas na baixa
  retentionsTotal Decimal @default(0) @db.Decimal(14, 2)
  notes         String?
  reversedAt    DateTime? // estorno
  reversalReason String?
  createdAt     DateTime  @default(now())
  createdById   String?

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  bankTransactions BankTransaction[]

  @@index([receivableId])
}

model FinancialRetention {
  id        String  @id @default(uuid(7))
  companyId String
  code      String  // ISS, INSS, IRRF, PIS, COFINS, CSLL...
  name      String
  percent   Decimal @default(0) @db.Decimal(9, 4) // zerado por padrão; usuário configura
  active    Boolean @default(false)

  @@unique([companyId, code])
}

enum InvoiceStatus {
  REGISTRADA
  EMITIDA
  ENVIADA
  CANCELADA
}

model Invoice {
  id                 String        @id @default(uuid(7))
  companyId          String
  number             String
  series             String?
  issuerCity         String?
  issueDate          DateTime
  competenceDate     DateTime?
  clientId           String
  contractId         String?
  projectId          String?
  grossValue         Decimal       @db.Decimal(14, 2)
  deductions         Decimal       @default(0) @db.Decimal(14, 2)
  retentions         Json?
  retentionsTotal    Decimal       @default(0) @db.Decimal(14, 2)
  netValue           Decimal       @db.Decimal(14, 2)
  serviceCode        String?
  serviceDescription String?
  status             InvoiceStatus @default(REGISTRADA)
  pdfAttachmentId    String?
  xmlAttachmentId    String?
  externalLink       String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdById        String?
  deletedAt          DateTime?

  client      Client              @relation(fields: [clientId], references: [id])
  contract    Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  receivables InvoiceReceivable[]

  @@unique([companyId, number, series])
  @@index([clientId])
}

model InvoiceReceivable {
  invoiceId    String
  receivableId String
  amount       Decimal? @db.Decimal(14, 2) // parte da NF alocada à parcela, se rateada

  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@id([invoiceId, receivableId])
}

model PaymentMethod {
  id        String  @id @default(uuid(7))
  companyId String
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  receivables Receivable[]

  @@unique([companyId, name])
}

enum PayableStatus {
  A_PAGAR
  PAGO
  CANCELADO
}

/// Contas a pagar — deliberadamente enxuto: sem cadastro de fornecedor nem
/// centro de custo, que só fariam sentido com contabilidade integrada.
model Payable {
  id          String        @id @default(uuid(7))
  companyId   String
  description String
  supplier    String? // nome livre; não há cadastro de fornecedores
  category    String? // Aluguel, Impostos, Salários, Fornecedores…
  projectId   String? // rateio simples: despesa ligada a um projeto
  dueDate     DateTime
  amount      Decimal       @db.Decimal(14, 2)
  paidAt      DateTime?
  paidAmount  Decimal?      @db.Decimal(14, 2)
  status      PayableStatus @default(A_PAGAR)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]

  @@index([companyId, status, dueDate])
}

enum CollectionEventType {
  LEMBRETE_PRE_VENCIMENTO
  AVISO_VENCIMENTO
  PRIMEIRO_AVISO_ATRASO
  SEGUNDO_AVISO_ATRASO
  COBRANCA_FORMAL
  RENEGOCIACAO
  ENCAMINHAMENTO_JURIDICO
}

model CollectionEvent {
  id           String              @id @default(uuid(7))
  companyId    String
  receivableId String
  eventType    CollectionEventType
  eventDate    DateTime            @default(now())
  channel      String?             // e-mail, whatsapp, telefone, carta
  templateUsed String?
  notes        String?
  createdById  String?

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([receivableId])
}

// ============================================================
// NOTIFICAÇÕES / IMPORTAÇÃO
// ============================================================

model Notification {
  id        String    @id @default(uuid(7))
  companyId String
  userId    String
  kind      String    // follow_up_vencido, proposta_vencendo, parcela_vencida...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

enum ImportStatus {
  PENDENTE
  VALIDANDO
  PRONTO_PARA_IMPORTAR
  IMPORTANDO
  CONCLUIDO
  FALHOU
  CANCELADO
}

model ImportJob {
  id          String       @id @default(uuid(7))
  companyId   String
  sourceType  String       // trello_json, csv_clientes, csv_oportunidades...
  fileName    String?
  mapping     Json?        // mapeamento colunas → campos
  status      ImportStatus @default(PENDENTE)
  totalRows   Int          @default(0)
  importedRows Int         @default(0)
  errorRows   Int          @default(0)
  report      Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?

  errors ImportError[]
}

model ImportError {
  id          String    @id @default(uuid(7))
  importJobId String
  rowNumber   Int?
  field       String?
  message     String
  rawData     Json?

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
}

// ============================================================
// EQUIPAMENTOS
// ============================================================

enum EquipmentStatus {
  DISPONIVEL
  EM_USO // saída registrada e ainda não devolvido
  MANUTENCAO
  BAIXADO // vendido, perdido ou descartado
}

/** Para onde o equipamento foi — muda o que se cobra na devolução. */
enum EquipmentMovementKind {
  OBRA // uso próprio em campo
  EMPRESTIMO // cedido a terceiro sem cobrança
  ALUGUEL // cedido com cobrança
  MANUTENCAO // foi para assistência ou calibração
}

model Equipment {
  id             String          @id @default(uuid(7))
  companyId      String
  code           String // EQP-AAAA-NNN
  name           String
  brand          String?
  model          String?
  serialNumber   String?
  category       String?
  status         EquipmentStatus @default(DISPONIVEL)
  purchaseDate   DateTime?
  purchaseValue  Decimal?        @db.Decimal(14, 2)
  /// Instrumentos de medição perdem validade legal sem calibração em dia.
  calibrationDueAt DateTime?
  /// Onde fica quando está parado (sala, armário, veículo).
  homeLocation   String?
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  movements EquipmentMovement[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

/**
 * Uma saída e a devolução correspondente.
 *
 * Enquanto `returnedAt` for nulo o equipamento está fora — é isso que
 * responde "quem está com o RE7000 e desde quando".
 */
model EquipmentMovement {
  id              String                @id @default(uuid(7))
  companyId       String
  equipmentId     String
  kind            EquipmentMovementKind @default(OBRA)
  projectId       String?
  clientId        String?
  /// Quem ficou responsável pelo equipamento (colaborador interno).
  holderUserId    String?
  /// Nome livre para quando quem levou não é usuário do sistema.
  holderName      String?
  destination     String?
  checkedOutAt    DateTime              @default(now())
  expectedReturnAt DateTime?
  conditionOut    String?
  returnedAt      DateTime?
  conditionIn     String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  checkedOutById  String?
  returnedById    String?

  equipment  Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  holderUser User?     @relation("EquipmentHolder", fields: [holderUserId], references: [id], onDelete: SetNull)

  @@index([companyId, returnedAt])
  @@index([equipmentId, checkedOutAt])
}

// ============================================================
// CONCILIACAO BANCARIA
// ============================================================

enum BankTransactionStatus {
  PENDENTE // importada, ainda sem par no sistema
  CONCILIADA // casada com um recebimento ou pagamento
  IGNORADA // transferencia interna, tarifa ja lancada etc.
}

/**
 * Linha do extrato bancário importado (OFX).
 *
 * O fitId e o identificador que o banco da a cada transacao: importa o mesmo
 * arquivo duas vezes e nada duplica.
 */
model BankTransaction {
  id          String                @id @default(uuid(7))
  companyId   String
  /// FITID do OFX — único por transação no banco.
  fitId       String
  postedAt    DateTime
  /// Positivo = entrada, negativo = saída, como vem no extrato.
  amount      Decimal               @db.Decimal(14, 2)
  memo        String?
  status      BankTransactionStatus @default(PENDENTE)
  /// Preenchido quando a linha casa com uma baixa de recebimento…
  receiptId   String?
  /// …ou com uma conta paga.
  payableId   String?
  importedAt  DateTime              @default(now())
  importedById String?
  reconciledAt DateTime?
  reconciledById String?

  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  payable Payable? @relation(fields: [payableId], references: [id], onDelete: SetNull)

  @@unique([companyId, fitId])
  @@index([companyId, status])
}

// ============================================================
// FOLLOW-UP COMERCIAL (automacoes)
// ============================================================

/** O que o sistema fez ou preparou sobre uma proposta. */
enum FollowUpKind {
  SEM_RETORNO // enviada ha N dias, cliente nao deu sinal
  VISUALIZADA_SEM_DECISAO // abriu e nao respondeu
  VALIDADE_PROXIMA // a proposta expira em breve
  EXPIRADA // passou da validade sem decisao
}

enum FollowUpChannel {
  EMAIL
  WHATSAPP
  /// Nenhum contato externo: so registrou o aviso interno.
  INTERNO
}

/**
 * Registro de cada toque de follow-up.
 *
 * A fila em si e calculada na hora (mesma escolha da cobranca e dos alertas:
 * nada para manter em dia). Esta tabela guarda apenas o que JA foi feito --
 * e ela que impede repetir o mesmo aviso e alimenta o historico da proposta.
 */
model FollowUpEvent {
  id         String          @id @default(uuid(7))
  companyId  String
  proposalId String
  kind       FollowUpKind
  channel    FollowUpChannel
  /// Para quem foi (e-mail do cliente) — nulo quando foi aviso interno.
  recipient  String?
  notes      String?
  createdAt  DateTime        @default(now())
  /// Quem aprovou o envio. Nulo = disparado pela rotina automatica.
  createdById String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([companyId, proposalId])
  @@index([proposalId, kind])
}

// ============================================================
// ENTREGA DE E-MAIL (webhook do provedor)
// ============================================================

enum EmailStatus {
  ENVIADO // aceito pelo provedor
  ENTREGUE // chegou na caixa do destinatario
  ABERTO // pixel de rastreio disparou (indicativo, nao prova)
  CLIQUE // clicou em um link da mensagem
  REJEITADO // bounce: endereco inexistente, caixa cheia
  SPAM // destinatario marcou como spam
  ATRASADO // provedor tentando de novo
}

/**
 * Situacao de entrega de cada e-mail enviado pelo sistema.
 *
 * Sem isto, digitar o e-mail errado do cliente e um erro silencioso: a
 * proposta consta como enviada e ninguem descobre que voltou.
 *
 * O providerId e o identificador que o Resend devolve no envio; e por ele que
 * o webhook encontra a mensagem depois.
 */
model EmailDelivery {
  id         String      @id @default(uuid(7))
  companyId  String
  /// ID da mensagem no provedor (Resend).
  providerId String      @unique
  para       String
  assunto    String
  status     EmailStatus @default(ENVIADO)
  /// A que se refere: proposal, receivable... — para achar pelo documento.
  entityType String?
  entityId   String?
  /// Motivo da rejeicao, quando houver.
  detalhe    String?
  sentAt     DateTime    @default(now())
  deliveredAt DateTime?
  openedAt   DateTime?
  failedAt   DateTime?
  updatedAt  DateTime    @updatedAt

  @@index([companyId, entityType, entityId])
  @@index([companyId, status])
}
