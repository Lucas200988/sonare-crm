# SONARE CRM — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env real.

# PostgreSQL (Supabase: Project Settings → Database → Connection string, modo "Transaction pooler" para app
# e "Direct connection" para migrações)
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"
# Conexão direta (sem pooler) usada pelo prisma migrate
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Segredo para assinar URLs de arquivos locais e tokens (gere com: openssl rand -hex 32)
APP_SECRET="troque-este-valor"

# Endereço público do sistema. OBRIGATÓRIO em produção: é o que vai nos QR
# codes de conferência dos documentos. Ex.: https://crm.sonareengenharia.com.br
APP_URL="http://localhost:3000"

# Armazenamento dos PDFs: supabase | local
# Em produção use "supabase" — servidores na nuvem apagam o disco a cada
# atualização, o que faria os documentos emitidos desaparecerem.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Supabase Storage (Project Settings → API)
SUPABASE_URL=""
# Chave "service_role": dá acesso total ao projeto. Só no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documentos"

# E-mail: resend | smtp | console
# O Gmail passou a exigir OAuth em SMTP (senha de app depende de liberacao do
# admin do Workspace). O Resend usa apenas uma chave e envia pelo seu dominio.
MAIL_DRIVER="console"

# Resend (resend.com) — plano gratuito: 3.000 e-mails/mes
RESEND_API_KEY=""

# SMTP (alternativa, caso prefira servidor proprio)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

MAIL_FROM="SONARE Engenharia <nao-responda@sonare.com.br>"

# Sessão
SESSION_TTL_HOURS="12"

# Inteligência artificial (geração de escopo de proposta)
# Opcional: a chave também pode ser cadastrada pela tela Configurações,
# onde fica criptografada no banco. Estas variáveis servem de fallback.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
CRON_SECRET="troque-por-um-segredo-longo-e-aleatorio"
